{
  "name": "cashrescue-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @cashrescue/server",
    "dev:client": "npm run dev --workspace @cashrescue/client",
    "start": "npm start --workspace @cashrescue/server",
    "test": "npm test --workspace @cashrescue/server",
    "build": "npm run build --workspace @cashrescue/client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
